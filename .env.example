# Modelo do arquivo de ambiente do SimpleClick.
#
# Copie para `.env` e preencha com os valores da SUA máquina:
#   cp .env.example .env
#
# Nenhum valor real mora aqui nem em qualquer arquivo versionado — segredo vem
# do ambiente, sempre (P-002). Os valores abaixo são marcadores; a API recusa
# iniciar apontando pelo nome a variável que faltar ou estiver inválida
# (AC-002), e `bash infra/scripts/check-ambientes.sh` reprova se o ambiente de
# teste apontar para o mesmo banco ou o mesmo cache da aplicação (AC-031).

# --- execução ---------------------------------------------------------------

# Ambiente de execução: development | test | production.
NODE_ENV=development

# Porta TCP em que a API escuta. Inteiro entre 1 e 65535.
PORT=3001

# Nível do registro estruturado: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# --- banco de dados ---------------------------------------------------------

# Conexão da aplicação, pelo agrupador em modo transação. O parâmetro que
# desliga instruções preparadas é obrigatório: sem ele o Prisma quebra de forma
# intermitente atrás do agrupador.
# Formato: postgresql://USUARIO:SENHA@MAQUINA:PORTA/BANCO?pgbouncer=true
DATABASE_URL=postgresql://TROQUE_USUARIO:TROQUE_SENHA@localhost:6432/simpleclick_dev?pgbouncer=true

# Conexão direta ao banco, sem agrupador, usada apenas pelas migrações — com a
# credencial de migração, que é a única dona do esquema.
DATABASE_URL_DIRETA=postgresql://TROQUE_USUARIO_MIGRACAO:TROQUE_SENHA@localhost:5432/simpleclick_dev

# Banco descartável usado pela suíte de testes. Obrigatório fora de produção e
# SEMPRE em um banco diferente do da aplicação: a suíte apaga e recria dados.
# Na primeira aplicação de um banco vazio, esta é também a credencial de
# arranque: criar papel de banco e gatilho de evento exige mais poder do que a
# credencial de migração tem no dia a dia.
DATABASE_URL_TEST=postgresql://TROQUE_USUARIO:TROQUE_SENHA@localhost:5432/simpleclick_test

# --- senhas dos três papéis de banco ----------------------------------------

# São três credenciais separadas, com agrupadores separados, e a separação é o
# que sustenta o isolamento entre lojas:
#   sc_migrator  dono do esquema, aplica migrações, conexão direta
#   sc_app       execução do dono de loja e do cliente — NÃO contorna o
#                isolamento
#   sc_admin     execução da administração, que enxerga todas as lojas
#
# Enxergar todas as lojas é CREDENCIAL, não marcação de sessão: se fosse
# marcação, uma falha de injeção numa rota de lojista escalaria para visão
# global mudando um valor.
#
# A migração cria os papéis com estes valores. Aceita letras, números e
# _ - . ~ + = com no mínimo 12 caracteres. Gere as suas:
#   openssl rand -hex 24
SENHA_BANCO_MIGRADOR=
SENHA_BANCO_APLICACAO=
SENHA_BANCO_ADMINISTRACAO=

# --- cache e filas ----------------------------------------------------------

# Cache descartável da aplicação e filas de segundo plano de e-mail e webhook
# (T-014). O índice ao fim do endereço separa os espaços lógicos dentro do
# mesmo servidor; as chaves de fila ainda ganham prefixo próprio, para que uma
# limpeza de cache por padrão de chave não leve trabalho enfileirado junto.
#
# A fila de IMPRESSÃO não mora aqui: ela vive no PostgreSQL, por decisão de
# 17/08, porque no plano gratuito o Redis é o primeiro serviço a cair — e cupom
# que não sai é pedido que a cozinha não vê.
REDIS_URL=redis://localhost:6379/0

# Cache e filas usados pela suíte de testes — outro índice ou outro servidor,
# nunca o mesmo do de cima.
REDIS_URL_TEST=redis://localhost:6379/1

# --- segurança --------------------------------------------------------------

# Segredo de assinatura dos tokens, com ao menos 32 caracteres. Gere o seu e
# não reaproveite entre ambientes:
#   openssl rand -base64 48
JWT_SECRET=TROQUE_POR_UM_SEGREDO_GERADO_COM_AO_MENOS_32_CARACTERES

# Lista fechada de origens autorizadas a chamar a API, separadas por vírgula.
# Só esquema, máquina e porta — nunca caminho.
ORIGENS_PERMITIDAS=https://simpleclick.localhost,https://api.simpleclick.localhost

# --- site -------------------------------------------------------------------

# Endereço da API que o site consulta. Não é segredo: é o nome público do
# serviço, o mesmo que aparece na lista de origens autorizadas acima. Sem esta
# variável o site usa o nome que o roteador local serve com TLS.
NEXT_PUBLIC_API_URL=https://api.simpleclick.localhost
# --- invalidação do cache do site (AC-028) ----------------------------------

# Endereço do site, para onde a API manda o aviso de "o catálogo desta loja
# mudou". As duas variáveis abaixo andam juntas: com uma só, a API chamaria o
# site sem se identificar e o site recusaria.
URL_DO_SITE=https://simpleclick.localhost

# Segredo compartilhado entre a API (que avisa) e o site (que invalida), com ao
# menos 32 caracteres. Sem ele configurado no site, a rota /api/revalidate
# recusa TODO MUNDO — abrir seria pior do que não existir. Gere o seu:
#   openssl rand -base64 48
SEGREDO_DE_REVALIDACAO=TROQUE_POR_UM_SEGREDO_GERADO_COM_AO_MENOS_32_CARACTERES
