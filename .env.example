# Modelo do arquivo de ambiente do SimpleClick.
#
# Copie para `.env` e preencha com os valores da SUA máquina:
#   cp .env.example .env
#
# Nenhum valor real mora aqui nem em qualquer arquivo versionado — segredo vem
# do ambiente, sempre (P-002). Os valores abaixo são marcadores; a API recusa
# iniciar apontando pelo nome a variável que faltar ou estiver inválida
# (AC-002), e `bash infra/scripts/check-ambientes.sh` reprova se o ambiente de
# teste apontar para o mesmo banco ou o mesmo cache da aplicação (AC-031).

# --- execução ---------------------------------------------------------------

# Ambiente de execução: development | test | production.
NODE_ENV=development

# Porta TCP em que a API escuta. Inteiro entre 1 e 65535.
PORT=3001

# Nível do registro estruturado: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# --- banco de dados ---------------------------------------------------------

# Conexão da aplicação, pelo agrupador em modo transação. O parâmetro que
# desliga instruções preparadas é obrigatório: sem ele o Prisma quebra de forma
# intermitente atrás do agrupador.
# Formato: postgresql://USUARIO:SENHA@MAQUINA:PORTA/BANCO?pgbouncer=true
DATABASE_URL=postgresql://TROQUE_USUARIO:TROQUE_SENHA@localhost:6432/simpleclick_dev?pgbouncer=true

# Conexão direta ao banco, sem agrupador, usada apenas pelas migrações — com a
# credencial de migração, que é a única dona do esquema.
DATABASE_URL_DIRETA=postgresql://TROQUE_USUARIO_MIGRACAO:TROQUE_SENHA@localhost:5432/simpleclick_dev

# Banco descartável usado pela suíte de testes. Obrigatório fora de produção e
# SEMPRE em um banco diferente do da aplicação: a suíte apaga e recria dados.
DATABASE_URL_TEST=postgresql://TROQUE_USUARIO:TROQUE_SENHA@localhost:5432/simpleclick_test

# --- cache ------------------------------------------------------------------

# Cache descartável da aplicação. O índice ao fim do endereço separa os
# espaços lógicos dentro do mesmo servidor.
REDIS_URL=redis://localhost:6379/0

# Cache usado pela suíte de testes — outro índice ou outro servidor, nunca o
# mesmo do de cima.
REDIS_URL_TEST=redis://localhost:6379/1

# --- segurança --------------------------------------------------------------

# Segredo de assinatura dos tokens, com ao menos 32 caracteres. Gere o seu e
# não reaproveite entre ambientes:
#   openssl rand -base64 48
JWT_SECRET=TROQUE_POR_UM_SEGREDO_GERADO_COM_AO_MENOS_32_CARACTERES

# Lista fechada de origens autorizadas a chamar a API, separadas por vírgula.
# Só esquema, máquina e porta — nunca caminho.
ORIGENS_PERMITIDAS=https://simpleclick.localhost,https://api.simpleclick.localhost
