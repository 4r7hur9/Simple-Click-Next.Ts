{
  "name": "@simpleclick/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --root ../.. --project unit apps/api/",
    "contrato:escrever": "node src/contracts/gerar.ts escrever",
    "contrato:verificar": "node src/contracts/gerar.ts verificar"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@simpleclick/contracts": "workspace:*",
    "@simpleclick/database": "workspace:*",
    "bullmq": "6.1.2",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@simpleclick/config-ts": "workspace:*",
    "@simpleclick/testing": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
