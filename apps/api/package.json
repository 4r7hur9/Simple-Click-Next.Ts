{
  "name": "@simpleclick/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:unit": "cd ../.. && vitest run --project unit apps/api/",
    "test:int": "cd ../.. && vitest run --project api-int --project filas --project cache-int apps/api/",
    "contrato:escrever": "node src/contracts/gerar.ts escrever",
    "contrato:verificar": "node src/contracts/gerar.ts verificar",
    "administracao:local": "node --env-file-if-exists=../../.env src/administracao-local.ts",
    "administracao:segredo": "node src/administracao-segredo.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/instrumentation": "7.10.0",
    "@redis/client": "6.3.0",
    "@simpleclick/contracts": "workspace:*",
    "@simpleclick/core": "workspace:*",
    "@simpleclick/database": "workspace:*",
    "bullmq": "6.3.14",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "pg": "catalog:",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@simpleclick/config-ts": "workspace:*",
    "@simpleclick/testing": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
