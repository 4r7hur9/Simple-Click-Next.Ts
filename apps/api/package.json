{
  "name": "@simpleclick/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --root ../.. --project unit apps/api/",
    "contrato:escrever": "node src/contracts/gerar.ts escrever",
    "contrato:verificar": "node src/contracts/gerar.ts verificar"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@redis/client": "6.3.0",
    "@simpleclick/contracts": "workspace:*",
    "@simpleclick/core": "workspace:*",
    "@simpleclick/database": "workspace:*",
    "bullmq": "6.3.14",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "pg": "catalog:",
    "pino": "10.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@simpleclick/config-ts": "workspace:*",
    "@simpleclick/testing": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
