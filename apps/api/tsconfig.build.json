{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_nota": "Só para gerar `dist`. O tsconfig.json inclui os testes, porque a verificação de tipos precisa olhar para eles; o pacote publicado, não — teste em imagem de produção só carrega peso e dependência que não existe lá.",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `rootDir` é assunto de geração, e por isso mora só aqui: no tsconfig de
    // verificação ele barraria `tests/`, que fica fora de `src/` e precisa ser
    // olhado pela checagem de tipos como qualquer outro código.
    "rootDir": "src"
  },
  // `src/administracao-local*.ts` é ferramenta de quem opera o banco LOCAL
  // (#163): roda pelo código-fonte (`pnpm administracao:local`) e não pode
  // existir na imagem da API. O mesmo vale para o gerador do segredo da
  // administração permanente (card #3), que roda no computador de quem opera.
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "tests",
    "src/administracao-local*.ts",
    "src/administracao-segredo*.ts"
  ]
}
