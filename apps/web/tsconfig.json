{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@simpleclick/config-ts/react.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    // `@simpleclick/contracts` é consumido pelo código-fonte, e o mesmo pacote
    // também é lido pela API, que roda em Node — lá a importação precisa
    // apontar para o arquivo que existe no disco, com extensão. Sem esta opção
    // aqui, a verificação de tipos do site reprovaria os arquivos internos do
    // contrato, e não o código do site.
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.ts"
  ],
  // A pasta de mentira que `tests/cores-projeto.test.ts` monta e desfaz para
  // provar a regra de cor (AC-014). Ela precisa nascer DENTRO de `apps/web`
  // para os padrões de camada valerem, mas não pode entrar na verificação de
  // tipos: o `tsc` de outro processo a pegaria no meio da vida e reprovaria por
  // arquivo que já não existe — resultado dependendo de quem mais está rodando
  // não é resultado reproduzível (AC-042).
  "exclude": ["node_modules", ".next", "src/features/__cores-temp"]
}
