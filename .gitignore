# dependências
node_modules/
.pnpm-store/

# saídas de build
dist/
.next/
out/
*.tsbuildinfo
# gerado pelo Next a cada build, e aponta para dentro de .next/ — versionar
# quebraria a verificação de tipos em clone sem build feito
apps/web/next-env.d.ts

# cliente tipado do banco: nasce do esquema declarado a cada instalação
# (`prepare`), e versionar código gerado só cria conflito que ninguém escreveu
packages/database/gerado/

# árvore de mentira que a prova de tipos do contrato monta e desfaz
# (apps/web/tests/contrato-tipos.test.ts). Só sobra aqui se o teste morrer no meio.
packages/contracts/.provas-de-tipo/

# componente de mentira que a prova da regra de cor monta e desfaz
# (apps/web/tests/cores-projeto.test.ts). Mesmo motivo.
apps/web/src/features/__cores-temp/

# cache de ferramentas
.turbo/
coverage/
.eslintcache

# testes de ponta a ponta
playwright-report/
test-results/
e2e/.auth/

# ambiente — nunca versionar valor real (P-002)
.env
.env.*
!.env.example
infra/compose/.env.compose
!infra/compose/.env.compose.example

# certificados de desenvolvimento
infra/traefik/certs/*
!infra/traefik/certs/.gitkeep

# relatórios do motor de especificação
.spec/.vitest-report.json
.spec/.jest-report.json

# sistema operacional e editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
