    "decisions": [
      {
        "id": "D-1",
        "decision": "Tons escuros do Stitch em superficie-alta, tinta-suave e sucesso; --cor-borda mantido",
        "why": "escolha do usuário; a divisória do Stitch (1,25:1) apagaria contornos",
        "impact": "landing e painel escuro mudam levemente"
      },
      {
        "id": "D-2",
        "decision": "Jakarta nas variáveis atuais; legadas com preload false; landing congelada redefinindo as 4 variáveis em body:has(.sc-lp-topo)",
        "why": "o usuário quer a landing congelada; legal.css lê --fonte-corpo direto e --fonte-titulo chega resolvida de :root",
        "alternatives": [
          "arquivo da landing (proibido)"
        ],
        "mitigation": "avisar #106; --fonte-legada-titulo disponível"
      },
      {
        "id": "D-3",
        "decision": "Brilho com tokens sem cor (--brilho-forma, --brilho-forca) e color-mix na regra .sc-botao--cta",
        "why": "custom property com var() em :root resolve na raiz e não seguiria a loja",
        "impact": "segue TemaDaMarca e TemaDaLoja"
      },
      {
        "id": "D-4",
        "decision": "Modificador novo .sc-botao--cta (prop cta) em vez de mudar .sc-botao--pilula",
        "why": "a pílula é usada no painel e na conta; Q-10405 restringe ao cliente"
      },
      {
        "id": "D-5",
        "decision": "Contrato server/client: Chip, FaixaDeChips, BarraInferior, Botao, Campo e Cartao só markup; Abas, Gaveta, AvisoFlutuante e BotaoMarcavel 'use client'",
        "why": "o #105 precisa usar a barra em layout de servidor com componenteDeLink"
      },
      {
        "id": "D-6",
        "decision": "BarraInferior: rotulo obrigatório, componenteDeLink, item href+atributos ou aoAcionar, oculta (inert), embutida, --altura-da-barra-inferior; viewportFit cover",
        "why": "pedidos do #105 e AC-10414"
      },
      {
        "id": "D-7",
        "decision": "Gaveta: preventDefault no cancel e aoFechar em onCancel e onClose; gatilho guardado antes de showModal",
        "why": "manter o estado controlado sincronizado (CloseWatcher)"
      },
      {
        "id": "D-8",
        "decision": "AvisoFlutuante com duas regiões vivas sempre montadas",
        "why": "anúncio confiável exige região existente antes do conteúdo"
      },
      {
        "id": "D-9",
        "decision": "Pulso por data-pulso só na transição (BotaoMarcavel client)",
        "why": "o SSR já marcado não pode pulsar ao carregar"
      },
      {
        "id": "D-10",
        "decision": "Foco da loja ajustado também contra superficie e superficieAlta em calcularTemaDaLoja",
        "why": "AC-10417 pede 3:1 contra a superfície em que a peça está",
        "mitigation": "parar e avisar se algum fixar valor"
      },
      {
        "id": "D-11",
        "decision": "Catraca do lucide: lista fixa de arquivos legados que só diminui",
        "why": "feed e legal são de outros donos; landing congelada"
      }
    ],
