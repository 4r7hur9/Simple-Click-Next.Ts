{
  "openapi": "3.1.1",
  "info": {
    "title": "SimpleClick API",
    "version": "0.1.0",
    "description": "Contrato gerado a partir dos esquemas de validação da API. Não edite este arquivo à mão: ele é regravado por `pnpm --filter @simpleclick/api run contrato:escrever` e conferido pelo portão de qualidade."
  },
  "servers": [
    {
      "url": "https://api.simpleclick.localhost",
      "description": "desenvolvimento local"
    },
    {
      "url": "https://api.simpleclick.app",
      "description": "produção"
    }
  ],
  "tags": [
    {
      "name": "saude",
      "description": "Sinais de vida e prontidão da API"
    },
    {
      "name": "vitrine",
      "description": "O que o público vê de uma loja. Nunca devolve chave PIX, documento, telefone do dono nem configuração interna."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "get_raiz",
        "summary": "Sinal de vida da API",
        "tags": [
          "saude"
        ],
        "description": "Diz que a API está no ar e qual serviço respondeu. Não consulta banco, não abre transação e não devolve dado de nenhuma loja.",
        "responses": {
          "200": {
            "description": "Requisição atendida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentificacaoDaApi"
                }
              }
            }
          },
          "404": {
            "description": "Endereço ou recurso inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/v1/vitrine/{apelido}": {
      "get": {
        "operationId": "get_v1_vitrine_por_apelido",
        "summary": "A loja como o público a vê",
        "tags": [
          "vitrine"
        ],
        "description": "Devolve o que a vitrine mostra de uma loja: nome, apresentação, cores, endereço para retirada e se ela está aberta agora, no fuso dela. Nunca devolve chave PIX, documento, telefone do dono nem configuração interna. Loja inexistente e loja suspensa respondem igual.",
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80,
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requisição atendida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Vitrine"
                }
              }
            }
          },
          "400": {
            "description": "Entrada recusada pelo contrato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Endereço ou recurso inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/v1/vitrine/{apelido}/catalogo": {
      "get": {
        "operationId": "get_v1_vitrine_por_apelido_catalogo",
        "summary": "As seções e os destaques da loja",
        "tags": [
          "vitrine"
        ],
        "description": "Devolve o catálogo público de uma loja: as seções visíveis na ordem que o dono definiu, com os produtos publicados de cada uma, e a lista de destaques. Traz também a versão do catálogo, que muda a cada alteração e serve para saber quando uma cópia guardada venceu. Loja inexistente e loja suspensa respondem igual.",
        "parameters": [
          {
            "name": "apelido",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80,
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Requisição atendida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "secoes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "apelido": {
                            "type": "string"
                          },
                          "nome": {
                            "type": "string"
                          },
                          "produtos": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "format": "uuid",
                                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                },
                                "apelido": {
                                  "type": "string"
                                },
                                "nome": {
                                  "type": "string"
                                },
                                "chamada": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "precoCentavos": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "precoAnteriorCentavos": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "minimum": 0,
                                      "maximum": 9007199254740991
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "imagem": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "destaque": {
                                  "type": "boolean"
                                },
                                "disponivel": {
                                  "type": "boolean"
                                }
                              },
                              "required": [
                                "id",
                                "apelido",
                                "nome",
                                "chamada",
                                "precoCentavos",
                                "precoAnteriorCentavos",
                                "imagem",
                                "destaque",
                                "disponivel"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "id",
                          "apelido",
                          "nome",
                          "produtos"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "destaques": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "apelido": {
                            "type": "string"
                          },
                          "nome": {
                            "type": "string"
                          },
                          "chamada": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "precoCentavos": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "precoAnteriorCentavos": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "imagem": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "destaque": {
                            "type": "boolean"
                          },
                          "disponivel": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "apelido",
                          "nome",
                          "chamada",
                          "precoCentavos",
                          "precoAnteriorCentavos",
                          "imagem",
                          "destaque",
                          "disponivel"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "versao": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "secoes",
                    "destaques",
                    "versao"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Entrada recusada pelo contrato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Endereço ou recurso inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    }
