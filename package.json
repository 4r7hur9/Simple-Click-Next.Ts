{
  "name": "simpleclick",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de vitrine, catálogo e pedidos para pequenos empreendedores",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:all",
    "lp": "pnpm --filter @simpleclick/web dev",
    "api": "pnpm --filter @simpleclick/api dev",
    "dev:all": "pnpm --parallel --filter @simpleclick/web --filter @simpleclick/api dev",
    "build:web": "pnpm --filter @simpleclick/web build",
    "start:web": "pnpm --filter @simpleclick/web start",
    "build:api": "pnpm --filter @simpleclick/api build",
    "start:api": "pnpm --filter @simpleclick/api start",
    "build": "turbo run build",
    "start": "pnpm --parallel --filter @simpleclick/web --filter @simpleclick/api start",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int --concurrency=1 --continue",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "vitest run --coverage",
    "openapi:gerar": "node apps/api/src/contracts/gerar.ts escrever && node apps/api/src/contracts/gerar.ts yaml",
    "openapi:verificar": "node apps/api/src/contracts/gerar.ts verificar && node apps/api/src/contracts/gerar.ts verificar-yaml",
    "openapi:lint": "npx --yes @stoplight/spectral-cli@6.15.0 lint docs/openapi.yaml --ruleset .spectral.yaml --fail-severity=warn",
    "db:gerar": "pnpm --filter @simpleclick/database run gerar",
    "prepare": "pnpm --filter @simpleclick/database run gerar"
  },
  "devDependencies": {
    "@simpleclick/config-eslint": "workspace:*",
    "@simpleclick/config-ts": "workspace:*",
    "@simpleclick/database": "workspace:*",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "prettier": "catalog:",
    "turbo": "2.11.7",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
