{
  "name": "simpleclick",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de vitrine, catálogo e pedidos para pequenos empreendedores",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @simpleclick/web dev",
    "lp": "pnpm --filter @simpleclick/web dev",
    "api": "pnpm --filter @simpleclick/api dev",
    "dev:all": "pnpm --parallel --filter @simpleclick/web --filter @simpleclick/api dev",
    "build:web": "pnpm --filter @simpleclick/web build",
    "start:web": "pnpm --filter @simpleclick/web start",
    "build:api": "pnpm --filter @simpleclick/api build",
    "start:api": "pnpm --filter @simpleclick/api start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "spec:audit": "node ~/.claude/skills/onp-spec-driven/scripts/onp-spec.mjs audit --ci",
    "spec:verify": "node ~/.claude/skills/onp-spec-driven/scripts/onp-spec.mjs verify",
    "db:gerar": "pnpm --filter @simpleclick/database run gerar",
    "prepare": "lefthook install && node infra/scripts/iniciar-registro-do-portao.mjs && pnpm --filter @simpleclick/database run gerar"
  },
  "devDependencies": {
    "@simpleclick/config-eslint": "workspace:*",
    "@simpleclick/config-ts": "workspace:*",
    "@simpleclick/database": "workspace:*",
    "@types/pg": "8.21.0",
    "eslint": "10.8.1",
    "lefthook": "2.1.10",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "turbo": "2.10.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
