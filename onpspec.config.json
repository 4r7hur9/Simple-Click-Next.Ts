{
  "testCommand": "pnpm vitest run --reporter=json --outputFile=.spec/.vitest-report.json",
  "reporter": "vitest-json",
  "reporterOutputFile": ".spec/.vitest-report.json",
  "testGlobs": [
    "apps/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.tsx",
    "apps/*/tests/**",
    "packages/*/src/**/*.test.ts",
    "packages/*/tests/**",
    "packages/*/seed/**/*.test.ts",
    "infra/tests/**",
    "e2e/**"
  ],
  "srcGlobs": [
    "apps/*/src/**",
    "packages/*/src/**",
    "packages/*/*.js",
    "packages/database/migrations/**",
    "infra/**"
  ],
  "ignoreGlobs": [
    "node_modules/**",
    ".git/**",
    "dist/**",
    "build/**",
    "coverage/**",
    ".spec/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/*.tsbuildinfo",
    "infra/compose/.env.compose",
    "infra/traefik/certs/**"
  ],
  "paralelo": {
    "maxFaixas": 4
  }
}
