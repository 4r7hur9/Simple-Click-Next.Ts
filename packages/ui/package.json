{
  "name": "@simpleclick/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./styles/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/theme.css": "./styles/theme.css",
    "./styles/componentes.css": "./styles/componentes.css",
    "./styles/narrativa.css": "./styles/narrativa.css",
    "./styles/landing.css": "./styles/landing.css",
    "./styles/vitrine.css": "./styles/vitrine.css",
    "./styles/produto.css": "./styles/produto.css",
    "./styles/fechamento.css": "./styles/fechamento.css",
    "./styles/conta.css": "./styles/conta.css",
    "./styles/exibicao.css": "./styles/exibicao.css"
  },
  "files": [
    "src",
    "styles"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --root ../.. --project unit packages/ui/"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@simpleclick/config-ts": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
