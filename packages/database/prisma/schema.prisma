// Esquema declarado do SimpleClick — existe para GERAR TIPOS, e só isso.
//
// A fonte da verdade da estrutura são as migrações SQL de `../migrations`. O
// Prisma não gera política de isolamento por linha, função, gatilho, índice
// parcial nem verificação de coluna, e é disso que este esquema é feito: um
// esquema gerado por ele nasceria sem o isolamento que sustenta o produto.
//
// Por isso este arquivo NÃO declara índice: quase todos são parciais ou sobre
// expressão (`lower(slug)`, `WHERE deleted_at IS NULL`, trigrama, GIN), e
// declarar aqui uma versão aproximada faria o esquema mentir sobre o banco.
//
// Dinheiro é sempre `BigInt` em centavos (P-005). Ponto flutuante não aparece
// neste arquivo, e a constituição verifica isso mecanicamente.
//
// Cobre o que as migrações 0001–0006 criam, mais as entidades de pedido e
// carrinho da 0008. As onze tabelas de catálogo da 0007 (categorias, variações,
// preços, grupos de opção, atributos) ainda não têm modelo: elas entram junto
// com as tarefas do catálogo, e a lista está escrita em
// `packages/database/tests/esquema-cobre-o-banco.test.ts`, que reprova se ela
// crescer sem ninguém decidir. Tabela sem modelo tipado obriga quem escreve
// código a usar SQL cru, que é justamente o que o arranjo do Prisma proíbe.

// O gerador escreve TypeScript em `../gerado/cliente`, que não é versionado e
// nasce de `pnpm --filter @simpleclick/database gerar`. Módulos ESM porque o
// monorepo inteiro é ESM, e execução em Node porque a API roda em Node.
generator client {
  provider     = "prisma-client"
  output       = "../gerado/cliente"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

// As cadeias de conexão NÃO moram aqui: desde o Prisma 7 o esquema não aceita
// `url` nem `directUrl`, e quem as recebe é o cliente, por adaptador de driver.
// Isso não muda o arranjo decidido, muda onde ele é escrito — as duas cadeias
// continuam distintas e vivem em `apps/api/src/core/db.ts` (aplicação, pelo
// agrupador) e no aplicador de migrações (direta, credencial de migração).
datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

/// Identidade global de acesso: uma pessoa, uma conta na plataforma inteira.
/// Nunca é visível para o dono de loja.
model Identity {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailNorm        String    @map("email_norm")
  passwordHash     String?   @map("password_hash")
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneE164        String?   @map("phone_e164")
  displayName      String?   @map("display_name")
  locale           String    @default("pt-BR")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  anonymizedAt     DateTime? @map("anonymized_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  admin               PlatformAdmin?     @relation("AdminDaPlataforma")
  adminsConcedios     PlatformAdmin[]    @relation("QuemConcedeu")
  lojasCriadas        Store[]            @relation("QuemCriouALoja")
  vinculos            StoreMember[]      @relation("VinculoDaIdentidade")
  convitesFeitos      StoreMember[]      @relation("QuemConvidou")
  produtosCriados     Product[]          @relation("QuemCriouOProduto")
  clientesDeLoja      StoreCustomer[]
  enderecos           CustomerAddress[]
  atosAuditados       AuditLog[]
  movimentosDeEstoque StockMovement[]
  mudancasDeStatus    OrderStatusEntry[] @relation("QuemMudouOStatus")

  @@map("identities")
  @@schema("app")
}

/// Quem administra a plataforma. Tabela separada para que o papel de
/// administração não seja alcançável por uma alteração numa rota de loja.
model PlatformAdmin {
  identityId String    @id @map("identity_id") @db.Uuid
  grantedBy  String?   @map("granted_by") @db.Uuid
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  identidade   Identity  @relation("AdminDaPlataforma", fields: [identityId], references: [id])
  quemConcedeu Identity? @relation("QuemConcedeu", fields: [grantedBy], references: [id])

  @@map("platform_admins")
  @@schema("app")
}

/// Catálogo global de tipos de negócio: vocabulário e composição de tela.
model VerticalPreset {
  code                    String   @id
  label                   String
  labels                  Json     @db.JsonB
  blocos                  Json     @default("{}") @db.JsonB
  defaultOptionGroupKinds String[] @map("default_option_group_kinds")
  schemaVersion           Int      @default(1) @map("schema_version")
  isFood                  Boolean  @default(false) @map("is_food")
  tracksStock             Boolean  @default(false) @map("tracks_stock")
  sortOrder               Int      @default(0) @map("sort_order")

  lojas    Store[]
  produtos Product[]

  @@map("vertical_presets")
  @@schema("app")
}

/// A loja: raiz do inquilino. Toda tabela de negócio aponta para cá.
model Store {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   String
  name                   String
  legalName              String?   @map("legal_name")
  docNumber              String?   @map("doc_number")
  docType                String?   @map("doc_type")
  slug                   String
  status                 String    @default("PENDING")
  verticalCode           String    @map("vertical_code")
  verticalSchemaVersion  Int       @default(1) @map("vertical_schema_version")
  timezone               String    @default("America/Sao_Paulo")
  currency               String    @default("BRL") @db.Char(3)
  openState              String    @default("SCHEDULE") @map("open_state")
  temporarilyClosedUntil DateTime? @map("temporarily_closed_until") @db.Timestamptz(6)
  fulfillmentModes       String[]  @map("fulfillment_modes")
  whatsappE164           String?   @map("whatsapp_e164")
  phone1                 String?
  phone2                 String?
  email                  String?
  street                 String?
  number                 String?
  complement             String?
  neighborhood           String?
  city                   String?
  uf                     String?
  zip                    String?
  lat                    Decimal?  @db.Decimal(9, 6)
  lng                    Decimal?  @db.Decimal(9, 6)
  catalogVersion         BigInt    @default(1) @map("catalog_version")
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  purgeAfter             DateTime? @map("purge_after") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  ramo                VerticalPreset       @relation(fields: [verticalCode], references: [code])
  quemCriou           Identity?            @relation("QuemCriouALoja", fields: [createdBy], references: [id])
  configuracao        StoreSettings?
  enderecos           StoreDomain[]
  membros             StoreMember[]
  produtos            Product[]
  clientes            StoreCustomer[]
  auditoria           AuditLog[]
  contadores          StoreSequence[]
  pedidos             Order[]
  contatos            OrderContact[]
  itensDePedido       OrderItem[]
  opcoesDeItem        OrderItemOption[]
  movimentosDeEstoque StockMovement[]
  historicoDePedidos  OrderStatusEntry[]
  carrinhos           Cart[]
  itensDeCarrinho     CartItem[]
  storeHours          StoreHour[]
  storeHourExceptions StoreHourException[]
  categories          Category[]

  @@map("stores")
  @@schema("app")
}

/// Configuração da loja em documento validado, com versão do esquema.
/// Guarda a chave PIX: nunca é lida diretamente pela vitrine.
model StoreSettings {
  storeId       String   @id @map("store_id") @db.Uuid
  theme         Json     @default("{}") @db.JsonB
  landing       Json     @default("{}") @db.JsonB
  checkout      Json     @default("{}") @db.JsonB
  delivery      Json     @default("{}") @db.JsonB
  payment       Json     @default("{}") @db.JsonB
  whatsapp      Json     @default("{}") @db.JsonB
  printing      Json     @default("{}") @db.JsonB
  seo           Json     @default("{}") @db.JsonB
  notifications Json     @default("{}") @db.JsonB
  schemaVersion Int      @default(1) @map("schema_version")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  loja Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
  @@schema("app")
}

/// Endereços que resolvem para a loja, incluindo o histórico de apelidos.
model StoreDomain {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId             String    @map("store_id") @db.Uuid
  host                String
  kind                String
  isCanonical         Boolean   @default(false) @map("is_canonical")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(6)
  redirectToCanonical Boolean   @default(false) @map("redirect_to_canonical")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  loja Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_domains")
  @@schema("app")
}

/// Vínculo entre identidade e loja, com papel. Separa "quem sou" de "o que
/// posso naquela loja".
model StoreMember {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String    @map("store_id") @db.Uuid
  identityId       String    @map("identity_id") @db.Uuid
  role             String
  permissions      Json      @default("{}") @db.JsonB
  invitedBy        String?   @map("invited_by") @db.Uuid
  inviteAcceptedAt DateTime? @map("invite_accepted_at") @db.Timestamptz(6)
  // Só o RESUMO do token do convite (migração 0032): o token em claro vai
  // apenas no e-mail do responsável, e o convite aceito zera as duas colunas.
  inviteTokenHash  String?   @map("invite_token_hash")
  inviteExpiresAt  DateTime? @map("invite_expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  loja         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  identidade   Identity  @relation("VinculoDaIdentidade", fields: [identityId], references: [id])
  quemConvidou Identity? @relation("QuemConvidou", fields: [invitedBy], references: [id])

  @@map("store_members")
  @@schema("app")
}

/// O produto genérico: uma tabela para comida, roupa, peça e eletrônico.
model Product {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId               String                   @map("store_id") @db.Uuid
  name                  String
  slug                  String
  description           String?
  shortDescription      String?                  @map("short_description")
  productType           String                   @default("SIMPLE") @map("product_type")
  verticalCode          String                   @map("vertical_code")
  verticalSchemaVersion Int                      @default(1) @map("vertical_schema_version")
  status                String                   @default("DRAFT")
  isAvailable           Boolean                  @default(true) @map("is_available")
  unavailableUntil      DateTime?                @map("unavailable_until") @db.Timestamptz(6)
  // Janelas semanais de venda no fuso da loja (0028, AC-322). Lista vazia é
  // "vende o dia inteiro"; a forma é conferida pelo próprio banco.
  saleWindows           Json                     @default("[]") @map("sale_windows") @db.JsonB
  unitLabel             String                   @default("un") @map("unit_label")
  trackStock            Boolean                  @default(false) @map("track_stock")
  sortOrder             Int                      @default(0) @map("sort_order")
  isFeatured            Boolean                  @default(false) @map("is_featured")
  attributes            Json                     @default("{}") @db.JsonB
  // Centavos inteiros, sempre. R$ 19,99 vezes 3 tem de dar exatamente
  // R$ 59,97 na vitrine, no fechamento, no WhatsApp e no cupom impresso.
  priceMinCents         BigInt?                  @map("price_min_cents")
  priceMaxCents         BigInt?                  @map("price_max_cents")
  displayPriceCents     BigInt?                  @map("display_price_cents")
  compareAtCents        BigInt?                  @map("compare_at_cents")
  hasVariants           Boolean                  @default(false) @map("has_variants")
  fractionSlots         Int?                     @map("fraction_slots") @db.SmallInt
  fractionPricing       String?                  @map("fraction_pricing")
  prepTimeMinutes       Int?                     @map("prep_time_minutes")
  seoTitle              String?                  @map("seo_title")
  seoDescription        String?                  @map("seo_description")
  // Coluna gerada pelo banco a partir de nome e descrição. O Prisma não a
  // escreve: quem a mantém é o próprio PostgreSQL.
  searchTsv             Unsupported("tsvector")? @map("search_tsv")
  deletedAt             DateTime?                @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy             String?                  @map("created_by") @db.Uuid

  loja      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ramo      VerticalPreset @relation(fields: [verticalCode], references: [code])
  quemCriou Identity?      @relation("QuemCriouOProduto", fields: [createdBy], references: [id])

  itensDePedido   OrderItem[]
  itensDeCarrinho CartItem[]
  categorias      ProductCategory[]
  imagens         ProductImage[]
  variacoes       ProductVariant[]
  gruposDeEscolha ProductOptionGroup[]

  @@map("products")
  @@schema("app")
}

/// A seção da vitrine — Lanches, Bebidas, Promoções.
///
/// A ORDEM É MANUAL, e não alfabética: qual seção vem primeiro é decisão de
/// negócio do dono, e não consequência da letra com que a palavra começa.
///
/// OCULTAR NÃO APAGA. A categoria sai da vitrine junto com seus produtos e
/// continua na gestão do dono, marcada como oculta — é assim que ele monta a
/// seção de Natal em outubro sem estreá-la. Quem garante que o público não a
/// veja é a política do banco, e não o `WHERE` de quem consulta (migração 0016).
model Category {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  name         String
  slug         String
  description  String?
  /// Subcategoria (Bebidas > Cervejas). Nasce aceitando nulo porque a pergunta
  /// Q-303 — se um nível basta — continua aberta: deixar o lugar reservado
  /// custa uma coluna nula, acrescentá-la depois custaria uma migração.
  parentId     String?   @map("parent_id") @db.Uuid
  imageAssetId String?   @map("image_asset_id") @db.Uuid
  isVisible    Boolean   @default(true) @map("is_visible")
  sortOrder    Int       @default(0) @map("sort_order")
  imageUrl     String?   @map("image_url")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  loja   Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  mae    Category?  @relation("SubcategoriaDe", fields: [parentId], references: [id])
  filhas Category[] @relation("SubcategoriaDe")

  produtos ProductCategory[]

  @@map("categories")
  @@schema("app")
}

/// Produto dentro de categoria.
///
/// É N:M, e não 1:N, porque o mesmo item aparece em "Promoções" e na seção
/// dele. Com 1:N o dono duplicaria o cadastro para promover um item —
/// fragmentando foto, descrição e, pior, as métricas dele.
model ProductCategory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  /// Ordem POR categoria: o mesmo produto pode ser o primeiro em Promoções e o
  /// quinto em Lanches.
  sortOrder  Int      @default(0) @map("sort_order")
  /// Uma primária por produto, para o endereço canônico e a trilha de
  /// navegação. Garantida por índice único parcial, e não por gatilho.
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  produto   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoria Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId, categoryId], map: "product_categories_uk")
  @@map("product_categories")
  @@schema("app")
}

/// A foto do produto.
///
/// A URL aceita nulo porque a imagem pode vir do acervo (`assetId`) em vez de
/// apontada direto — o banco cobra que ao menos uma das duas exista.
model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  assetId   String?  @map("asset_id") @db.Uuid
  url       String?
  altText   String?  @map("alt_text")
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  width     Int?
  height    Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  produto Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
  @@schema("app")
}

/// O comprador visto pela loja: projeção da identidade global com o que o dono
/// precisa para entregar, e nada além disso.
model StoreCustomer {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  identityId      String?   @map("identity_id") @db.Uuid
  displayName     String?   @map("display_name")
  phoneE164       String?   @map("phone_e164")
  phoneHmac       Bytes?    @map("phone_hmac")
  email           String?
  docNumber       String?   @map("doc_number")
  birthDate       DateTime? @map("birth_date") @db.Date
  notes           String?
  ordersCount     Int       @default(0) @map("orders_count")
  totalSpentCents BigInt    @default(0) @map("total_spent_cents")
  lastOrderAt     DateTime? @map("last_order_at") @db.Timestamptz(6)
  anonymizedAt    DateTime? @map("anonymized_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  /// Gerada pelo banco a partir de `phone_e164` (0035): só se lê, nunca se escreve.
  phoneKey        String?   @map("phone_key")
  /// Remoção com retenção: a ficha some das listagens e a linha fica (0035, AC-705).
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(6)
  /// Endereço anotado na ficha do cliente sem conta (0035, AC-703).
  address         Json?

  loja       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  identidade Identity? @relation(fields: [identityId], references: [id])

  pedidos   Order[]
  carrinhos Cart[]

  @@map("store_customers")
  @@schema("app")
}

/// Endereços salvos do comprador, presos à identidade e não à loja: cadastra
/// uma vez e usa em qualquer loja (0036, AC-509). Fora do perímetro do dono.
model CustomerAddress {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId     String    @map("identity_id") @db.Uuid
  label          String?
  recipientName  String?   @map("recipient_name")
  street         String
  number         String?
  complement     String?
  neighborhood   String?
  city           String?
  uf             String?   @db.Char(2)
  zip            String?
  referencePoint String?   @map("reference_point")
  isDefault      Boolean   @default(false) @map("is_default")
  anonymizedAt   DateTime? @map("anonymized_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  identidade Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
  @@schema("app")
}

/// Trilha de auditoria: só acrescenta. Alteração e remoção são negadas por
/// ausência de política, por retirada de privilégio e por gatilho.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  storeId    String   @map("store_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  beforeData Json?    @map("before_data") @db.JsonB
  afterData  Json?    @map("after_data") @db.JsonB
  ipHmac     Bytes?   @map("ip_hmac")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  loja  Store     @relation(fields: [storeId], references: [id])
  autor Identity? @relation(fields: [actorId], references: [id])

  @@map("audit_log")
  @@schema("app")
}

/// Contador do número do pedido, POR LOJA. Uma sequência global do PostgreSQL
/// não serve: a loja recém-aberta receberia um número que revela quanto a
/// plataforma inteira já vendeu, e com buracos enormes entre um pedido e o
/// seguinte da mesma loja. O incremento é atômico, na função
/// `app.proximo_numero_de_pedido`.
model StoreSequence {
  storeId   String   @map("store_id") @db.Uuid
  kind      String
  prefix    String   @default("")
  lastValue BigInt   @default(0) @map("last_value")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  loja Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, kind])
  @@map("store_sequences")
  @@schema("app")
}

/// O pedido. NÃO guarda dado pessoal: nome, telefone e endereço moram em
/// `OrderContact`, e é isso que torna o apagamento a pedido do titular uma
/// alteração de uma linha só. Todo valor em dinheiro é inteiro em centavos, e
/// as parcelas são guardadas separadas do total para que a conta possa ser
/// explicada ao cliente e ao dono.
model Order {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                String    @map("store_id") @db.Uuid
  number                 BigInt
  code                   String
  publicToken            String    @unique(map: "orders_public_token_uk") @map("public_token")
  storeCustomerId        String?   @map("store_customer_id") @db.Uuid
  status                 String    @default("PENDING")
  channel                String    @default("ONLINE")
  fulfillment            String    @default("DELIVERY")
  paymentMethod          String?   @map("payment_method")
  changeForCents         BigInt?   @map("change_for_cents")
  pixKeySnapshot         String?   @map("pix_key_snapshot")
  pixHolderSnapshot      String?   @map("pix_holder_snapshot")
  subtotalCents          BigInt    @default(0) @map("subtotal_cents")
  itemsTotalCents        BigInt    @default(0) @map("items_total_cents")
  couponDiscountCents    BigInt    @default(0) @map("coupon_discount_cents")
  deliveryFeeCents       BigInt    @default(0) @map("delivery_fee_cents")
  deliveryFeeMode        String?   @map("delivery_fee_mode")
  pickupDiscountCents    BigInt    @default(0) @map("pickup_discount_cents")
  discountCents          BigInt    @default(0) @map("discount_cents")
  totalCents             BigInt    @default(0) @map("total_cents")
  currency               String    @default("BRL") @db.Char(3)
  paymentStatus          String    @default("PENDING") @map("payment_status")
  pixKeyTypeSnapshot     String?   @map("pix_key_type_snapshot")
  pixAccountNameSnapshot String?   @map("pix_account_name_snapshot")
  pixBrcodeSnapshot      String?   @map("pix_brcode_snapshot")
  couponId               String?   @map("coupon_id") @db.Uuid
  couponCodeSnapshot     String?   @map("coupon_code_snapshot")
  customerNote           String?   @map("customer_note")
  storeNote              String?   @map("store_note")
  idempotencyKey         String?   @map("idempotency_key")
  whatsappMessageChars   Int?      @map("whatsapp_message_chars")
  scheduledFor           DateTime? @map("scheduled_for") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  costTotalCents         BigInt?   @map("cost_total_cents")
  notes                  String?
  whatsappClickedAt      DateTime? @map("whatsapp_clicked_at") @db.Timestamptz(6)
  whatsappConfirmedAt    DateTime? @map("whatsapp_confirmed_at") @db.Timestamptz(6)
  storeTimezone          String    @default("America/Sao_Paulo") @map("store_timezone")
  placedAt               DateTime  @default(now()) @map("placed_at") @db.Timestamptz(6)
  acceptedAt             DateTime? @map("accepted_at") @db.Timestamptz(6)
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt            DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason           String?   @map("cancel_reason")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Vias do cupom emitidas; a via impressa é o valor depois de somar 1 (0030, AC-621).
  printCount             Int       @default(0) @map("print_count")
  lastPrintedAt          DateTime? @map("last_printed_at") @db.Timestamptz(6)

  loja    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cliente StoreCustomer? @relation(fields: [storeCustomerId], references: [id])

  contato             OrderContact?
  itens               OrderItem[]
  historico           OrderStatusEntry[]
  movimentosDeEstoque StockMovement[]

  @@map("orders")
  @@schema("app")
}

/// Os dados pessoais do pedido, separados dele de propósito. Um pedido por
/// contato, e é por isso que a chave primária é o próprio pedido.
model OrderContact {
  orderId        String    @id @map("order_id") @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  name           String
  phoneE164      String    @map("phone_e164")
  phoneHmac      String?   @map("phone_hmac")
  email          String?
  docNumber      String?   @map("doc_number")
  recipientName  String?   @map("recipient_name")
  street         String?
  number         String?
  complement     String?
  neighborhood   String?
  city           String?
  uf             String?   @db.Char(2)
  zip            String?
  referencePoint String?   @map("reference_point")
  lat            Decimal?  @db.Decimal(10, 7)
  lng            Decimal?  @db.Decimal(10, 7)
  anonymizedAt   DateTime? @map("anonymized_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  pedido Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  loja   Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("order_contacts")
  @@schema("app")
}

/// Item comprado, como CÓPIA CONGELADA do momento da compra (P-010). Nome,
/// preço e variação são texto e número guardados aqui — a referência ao produto
/// existe para relatório, e nunca para ler preço. A tabela não tem política de
/// alteração nem de remoção: a imutabilidade é imposta pelo banco.
model OrderItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId            String   @map("store_id") @db.Uuid
  orderId            String   @map("order_id") @db.Uuid
  productId          String?  @map("product_id") @db.Uuid
  variantId          String?  @map("variant_id") @db.Uuid
  productName        String   @map("product_name")
  variantName        String?  @map("variant_name")
  skuSnapshot        String?  @map("sku_snapshot")
  quantity           Int
  unitPriceCents     BigInt   @map("unit_price_cents")
  compareAtCents     BigInt?  @map("compare_at_cents")
  unitCostCents      BigInt?  @map("unit_cost_cents")
  priceKindSnapshot  String?  @map("price_kind_snapshot")
  attributesSnapshot Json     @default("{}") @map("attributes_snapshot")
  optionsTotalCents  BigInt   @default(0) @map("options_total_cents")
  lineTotalCents     BigInt   @map("line_total_cents")
  note               String?
  fractionIndex      Int?     @map("fraction_index") @db.SmallInt
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pedido  Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  loja    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  produto Product? @relation(fields: [productId], references: [id])

  opcoes OrderItemOption[]

  @@map("order_items")
  @@schema("app")
}

/// Escolha registrada num item ("sem cebola", "borda recheada"), também como
/// cópia congelada: o nome do grupo e o da opção são texto guardado aqui.
model OrderItemOption {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId              String   @map("store_id") @db.Uuid
  orderItemId          String   @map("order_item_id") @db.Uuid
  optionGroupId        String?  @map("option_group_id") @db.Uuid
  optionItemId         String?  @map("option_item_id") @db.Uuid
  groupNameSnapshot    String   @map("group_name_snapshot")
  optionNameSnapshot   String   @map("option_name_snapshot")
  kindSnapshot         String?  @map("kind_snapshot")
  externalCodeSnapshot String?  @map("external_code_snapshot")
  action               String   @default("ADD")
  quantity             Int      @default(1)
  priceDeltaCents      BigInt   @default(0) @map("price_delta_cents")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  loja Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("order_item_options")
  @@schema("app")
}

/// Cada passo do pedido pela fila da loja. O pedido MUDA de estado e nunca é
/// apagado — por isso o histórico é só de acréscimo.
model OrderStatusEntry {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId             String   @map("store_id") @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  fromStatus          String?  @map("from_status")
  toStatus            String   @map("to_status")
  changedByIdentityId String?  @map("changed_by_identity_id") @db.Uuid
  actorRole           String?  @map("actor_role")
  reason              String?
  occurredAt          DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pedido    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  loja      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  quemMudou Identity? @relation("QuemMudouOStatus", fields: [changedByIdentityId], references: [id])

  @@map("order_status_history")
  @@schema("app")
}

/// Carrinho antes de virar pedido. Ao contrário do pedido, as chaves aqui são
/// VIVAS: o carrinho aponta para o produto de verdade, justamente para avisar
/// quando o preço mudou entre montar e fechar.
model Cart {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  storeCustomerId String?   @map("store_customer_id") @db.Uuid
  sessionToken    String    @map("session_token")
  channel         String    @default("ONLINE")
  convertedAt     DateTime? @map("converted_at") @db.Timestamptz(6)
  abandonedAt     DateTime? @map("abandoned_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  loja    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cliente StoreCustomer? @relation(fields: [storeCustomerId], references: [id])

  itens CartItem[]

  @@map("carts")
  @@schema("app")
}

/// Item do carrinho, ainda ligado ao produto vivo.
model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  quantity  Int      @default(1)
  notes     String?
  options   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  carrinho Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  loja     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  produto  Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
  @@schema("app")
}

/// Grade semanal de funcionamento, com várias faixas por dia (almoço e jantar).
/// A hora é `time` e não `timestamptz` de propósito: faixa de funcionamento não
/// tem data, e guardar com fuso faria a faixa escorregar no horário de verão.
model StoreHour {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  /// 0 no domingo, como o JavaScript numera. Uma numeração só, do banco à tela.
  weekday   Int      @db.SmallInt
  opensAt   DateTime @map("opens_at") @db.Time(6)
  closesAt  DateTime @map("closes_at") @db.Time(6)
  isClosed  Boolean  @default(false) @map("is_closed")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  loja Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_hours")
  @@schema("app")
}

/// Feriado, férias, fechamento pontual. Existe para o dono NÃO desconfigurar a
/// grade semanal só para fechar um dia — e não ter de reconfigurá-la de memória
/// no dia seguinte.
model StoreHourException {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  onDate    DateTime  @map("on_date") @db.Date
  isClosed  Boolean   @default(true) @map("is_closed")
  opensAt   DateTime? @map("opens_at") @db.Time(6)
  closesAt  DateTime? @map("closes_at") @db.Time(6)
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  loja Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_hour_exceptions")
  @@schema("app")
}

/// A unidade que de fato é vendida, e a que tem estoque.
///
/// É AQUI QUE VARIAÇÃO DIFERE DE INGREDIENTE. Bacon acaba para o produto
/// inteiro; camiseta tamanho M acaba só no M, e o M tem código de estoque
/// próprio. Por isso variante é linha, e adicional é opção.
///
/// `stockQuantity` nulo significa "não controla estoque" — o caso da
/// lanchonete. Zero significa "controla e acabou" — o caso da loja de roupa.
/// As duas coisas são diferentes, e um `0` no lugar do nulo faria toda
/// lanchonete nascer esgotada.
model ProductVariant {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  productId     String    @map("product_id") @db.Uuid
  name          String
  sku           String?
  barcode       String?
  stockQuantity Int?      @map("stock_quantity")
  stockReserved Int?      @map("stock_reserved")
  stockMinAlert Int?      @map("stock_min_alert")
  weightGrams   Int?      @map("weight_grams")
  /// A que vem escolhida ao abrir o produto: sem ela, a loja de roupa abre sem
  /// tamanho marcado e o cliente decide antes de ver o preço.
  isDefault     Boolean   @default(false) @map("is_default")
  isAvailable   Boolean   @default(true) @map("is_available")
  sortOrder     Int       @default(0) @map("sort_order")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  produto Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  precos              ProductPrice[]
  valoresDeEixo       VariantOptionValue[]
  movimentosDeEstoque StockMovement[]

  @@map("product_variants")
  @@schema("app")
}

/// Um preço nomeado do produto, ou da variante quando ela existe.
///
/// PENDURA NA VARIANTE quando há uma: pizza P e G têm preços diferentes do
/// mesmo produto. O rótulo é do dono — "Balcão", "Terça do pastel", "Dúzia" —
/// porque lista fixa obrigaria o negócio dele a caber no nosso vocabulário.
model ProductPrice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  variantId   String?   @map("variant_id") @db.Uuid
  kind        String    @default("BASE")
  label       String?
  /// Centavos inteiros, sempre (P-005).
  amountCents BigInt    @map("amount_cents")
  /// Preço de atacado que vale a partir de N unidades.
  minQuantity Int       @default(1) @map("min_quantity")
  currency    String    @default("BRL") @db.Char(3)
  sortOrder   Int       @default(0) @map("sort_order")
  startsAt    DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  variante ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("product_prices")
  @@schema("app")
}

/// O grupo de escolha: sabores, adicionais, tamanho, especificação.
///
/// `productId` nulo significa grupo de BIBLIOTECA, reusável em vários produtos —
/// o dono cadastra "Adicionais" uma vez e liga a vinte itens. Preenchido
/// significa grupo que só existe naquele produto.
///
/// OBRIGATORIEDADE É DERIVADA de `minSelect >= 1`. Um campo próprio seria
/// redundante e abriria a chance de divergir do mínimo.
model OptionGroup {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  productId     String?   @map("product_id") @db.Uuid
  name          String
  description   String?
  /// `INGREDIENT`, `ADDON`, `VARIATION`, `FRACTION` ou `SPEC`.
  kind          String    @default("ADDON")
  /// Quantas frações o grupo divide, para meio a meio e cento de salgados.
  fractionSlots Int?      @map("fraction_slots") @db.SmallInt
  isActive      Boolean   @default(true) @map("is_active")
  minSelect     Int       @default(0) @map("min_select")
  maxSelect     Int?      @map("max_select")
  allowRepeat   Boolean   @default(false) @map("allow_repeat")
  maxPerOption  Int?      @map("max_per_option")
  /// Quando verdadeiro, a escolha deste grupo resolve qual variante é vendida.
  isVariantAxis Boolean   @default(false) @map("is_variant_axis")
  sortOrder     Int       @default(0) @map("sort_order")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  itens         OptionItem[]
  produtos      ProductOptionGroup[]
  valoresDeEixo VariantOptionValue[]

  @@map("option_groups")
  @@schema("app")
}

/// Uma opção dentro de um grupo.
///
/// `priceDeltaCents` pode ser NEGATIVO: remover algo pode dar desconto.
///
/// Opção esgotada aparece indisponível sem bloquear o produto inteiro — só o
/// cheddar acabou, o hambúrguer continua à venda.
model OptionItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId           String    @map("store_id") @db.Uuid
  groupId           String    @map("group_id") @db.Uuid
  name              String
  priceDeltaCents   BigInt    @default(0) @map("price_delta_cents")
  /// Já vem marcada: o sabor mais pedido aparece selecionado, e quem quer outro
  /// troca. Um clique a menos no celular, no fim do dia, é pedido a mais.
  isDefaultSelected Boolean   @default(false) @map("is_default_selected")
  externalCode      String?   @map("external_code")
  isAvailable       Boolean   @default(true) @map("is_available")
  sortOrder         Int       @default(0) @map("sort_order")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  grupo         OptionGroup          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  valoresDeEixo VariantOptionValue[]

  @@map("option_items")
  @@schema("app")
}

/// Liga produto a grupo, para o dono cadastrar "Adicionais" uma vez e reusar em
/// vinte produtos. A ordem é do vínculo, e não do grupo: o mesmo grupo aparece
/// em posições diferentes em produtos diferentes.
model ProductOptionGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  produto Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  grupo   OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("product_option_groups")
  @@schema("app")
}

/// Resolve a grade: qual valor de cada eixo identifica cada variante. É o que
/// liga "P + azul" à peça que tem estoque.
model VariantOptionValue {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  groupId      String   @map("group_id") @db.Uuid
  optionItemId String   @map("option_item_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  variante ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  grupo    OptionGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  opcao    OptionItem     @relation(fields: [optionItemId], references: [id], onDelete: Cascade)

  @@map("variant_option_values")
  @@schema("app")
}

/// Cada ajuste de estoque é um fato imutável: nunca sobrescrevemos a contagem
/// anterior, porque o dono precisa saber o que mudou, por quê e quem fez.
model StockMovement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  variantId      String   @map("variant_id") @db.Uuid
  quantityBefore Int      @map("quantity_before")
  quantityDelta  Int      @map("quantity_delta")
  quantityAfter  Int      @map("quantity_after")
  reason         String
  origin         String   @default("MANUAL")
  orderId        String?  @map("order_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  loja     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variante ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  pedido   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  autor    Identity?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("stock_movements")
  @@schema("app")
}

/// A especificação que o dono cria DENTRO da categoria (T-301): Aro e Largura
/// em Pneus, Tamanho e Malha em Camisetas. É o registro tipado que impede o
/// cadastro de virar campo livre — o valor do produto só existe ligado a uma
/// definição daqui.
///
/// REMOVER NÃO APAGA: `deprecatedAt` tira a especificação da categoria e do
/// formulário, mas a linha fica, porque produto preenchido e pedido antigo
/// continuam citando o nome da época. A história de nome e de remoção fica na
/// trilha de auditoria.
///
/// Sem relação declarada com loja, categoria e produto de propósito: os
/// modelos de lá não precisam navegar até aqui, e a chave estrangeira mora na
/// migração 0007, que é a fonte da verdade da estrutura.
model AttributeDefinition {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String    @map("store_id") @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  /// Identidade estável da especificação no endereço do filtro da vitrine.
  /// Renomear muda o rótulo, nunca a chave: link compartilhado continua valendo.
  key            String
  label          String
  /// TEXT, NUMBER, ENUM ou BOOLEAN — a verificação mora no banco.
  dataType       String    @default("TEXT") @map("data_type")
  unit           String?
  /// Lista fechada de valores aceitos, quando o tipo é ENUM.
  allowedValues  Json?     @map("allowed_values") @db.JsonB
  isRequired     Boolean   @default(false) @map("is_required")
  isFilterable   Boolean   @default(false) @map("is_filterable")
  sortOrder      Int       @default(0) @map("sort_order")
  createdByOwner Boolean   @default(true) @map("created_by_owner")
  deprecatedAt   DateTime? @map("deprecated_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  valores ProductAttribute[]

  @@map("attribute_definitions")
  @@schema("app")
}

/// O valor que um produto tem para uma especificação. Exatamente uma coluna de
/// valor preenchida — o banco cobra. Número é `Decimal` (o `numeric` do banco),
/// nunca ponto flutuante: 195,5 mm tem de voltar 195,5.
model ProductAttribute {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  definitionId String    @map("definition_id") @db.Uuid
  valueText    String?   @map("value_text")
  valueNum     Decimal?  @map("value_num") @db.Decimal
  valueBool    Boolean?  @map("value_bool")
  valueDate    DateTime? @map("value_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  definicao AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@map("product_attributes")
  @@schema("app")
}

/// Contrato e documentos do responsável pela loja (admin-lojas, T-205,
/// migração 0033). Só a credencial da administração alcança a tabela: nem o
/// próprio dono vê o contrato pela conexão das lojas (AC-205). Os bytes moram
/// no armazenamento privado; aqui fica o que os descreve.
///
/// Sem relação declarada com `Store` e `Identity` de propósito: a chave
/// estrangeira existe no banco, e a leitura é da administração, por consulta
/// própria — declarar a relação obrigaria a mexer nos dois modelos centrais.
model StoreContract {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId          String   @map("store_id") @db.Uuid
  /// CONTRACT, ID_DOC ou ADDRESS_PROOF.
  kind             String
  /// `<loja>/<uuid>`, gerada pelo servidor; nunca o nome do arquivo.
  storageKey       String   @map("storage_key")
  /// Conferido pelos bytes, nunca pela extensão (AC-204).
  mimeType         String   @map("mime_type")
  byteSize         BigInt   @map("byte_size")
  sha256           Bytes
  originalFilename String?  @map("original_filename")
  uploadedBy       String   @map("uploaded_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([storeId, storageKey], map: "store_contracts_chave_uk")
  @@index([storeId, kind, createdAt(sort: Desc)], map: "store_contracts_loja_ix")
  @@map("store_contracts")
  @@schema("app")
}

/// Exceções de funcionalidade por loja (admin-lojas, T-207, migração 0040).
/// Sem linha, a funcionalidade está ligada (AC-213). Só a administração
/// escreve; a equipe da loja lê a linha da própria loja.
///
/// Sem relação declarada com `Store` e `Identity`, pelo mesmo motivo de
/// `StoreContract`: a chave estrangeira existe no banco.
model StoreFeatureOverride {
  storeId    String   @map("store_id") @db.Uuid
  /// Chave do catálogo de `packages/core/src/funcionalidades.ts`.
  featureKey String   @map("feature_key")
  isEnabled  Boolean  @map("is_enabled")
  limitValue BigInt?  @map("limit_value")
  reason     String
  setBy      String   @map("set_by") @db.Uuid
  setAt      DateTime @default(now()) @map("set_at") @db.Timestamptz(6)

  @@id([storeId, featureKey])
  @@map("store_feature_overrides")
  @@schema("app")
}

/// Agente de impressão pareado com a loja (0034, T-607/T-608). Guarda só o
/// sha256 da credencial que ele recebe no pareamento — nunca a credencial.
/// Revogar é preencher `revokedAt`; agente não se apaga.
///
/// Sem relação declarada com loja de propósito: o modelo da loja não precisa
/// navegar até aqui, e a chave estrangeira mora na migração 0034.
model PrintAgent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  name            String
  tokenSha256     Bytes     @map("token_sha256")
  agentVersion    String?   @map("agent_version")
  /// Último contato do agente: é o que diz ao painel que ele está fora do ar.
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("print_agents")
  @@schema("app")
}

/// Um trabalho da fila de impressão (0034, T-607): um cupom, com identificador
/// próprio. QUEUED, LEASED, PRINTED, FAILED, DEAD ou CANCELED — a verificação
/// mora no banco. `blocks` é o cupom semântico versão 1, nulo até a primeira
/// reivindicação, que soma a via e o grava; o reenvio entrega o mesmo cupom.
///
/// Sem relação declarada, pelo mesmo motivo de `PrintAgent`.
model PrintJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  orderCode   String    @map("order_code")
  agentId     String?   @map("agent_id") @db.Uuid
  status      String    @default("QUEUED")
  blocks      Json?     @db.JsonB
  attempt     Int       @default(0) @db.SmallInt
  leaseUntil  DateTime? @map("lease_until") @db.Timestamptz(6)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lastError   String?   @map("last_error")
  printedAt   DateTime? @map("printed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("print_jobs")
  @@schema("app")
}
