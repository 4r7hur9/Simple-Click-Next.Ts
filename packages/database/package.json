{
  "name": "@simpleclick/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/migrate.ts",
    "./arranque": "./src/arranque.ts",
    "./cliente": "./gerado/cliente/client.ts"
  },
  "scripts": {
    "gerar": "prisma generate --schema prisma/schema.prisma",
    "migrar": "node --env-file-if-exists=../../.env src/migrate.ts aplicar",
    "migrar:verificar": "node --env-file-if-exists=../../.env src/migrate.ts verificar",
    "guardas": "node src/guards.ts",
    "seed": "node --env-file-if-exists=../../.env seed/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:int": "vitest run --root ../.. --project db-rls packages/database/"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@simpleclick/config-ts": "workspace:*",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "prisma": "7.9.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
