{
  "name": "@simpleclick/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/migrate.ts",
    "./arranque": "./src/arranque.ts",
    "./cliente": "./gerado/cliente/client.ts",
    "./administracao-local": "./seed/administracao-local.ts"
  },
  "scripts": {
    "gerar": "prisma generate --schema prisma/schema.prisma",
    "migrar": "node --env-file-if-exists=../../.env src/migrate.ts aplicar",
    "migrar:verificar": "node --env-file-if-exists=../../.env src/migrate.ts verificar",
    "guardas": "node src/guards.ts",
    "seed": "node --env-file-if-exists=../../.env seed/index.ts",
    "demo": "node --env-file-if-exists=../../.env seed/demo/index.ts",
    "admin:local": "node --env-file-if-exists=../../.env seed/administracao-local.ts",
    "importar:winsis": "node --env-file-if-exists=../../.env seed/winsis/index.ts",
    "seed:simulacao": "node --env-file-if-exists=../../.env seed/simulacao/index.ts",
    "seed:simulacao:aplicacao": "node --env-file-if-exists=../../.env seed/simulacao/aplicacao.ts",
    "seed:simulacao:validar": "node --env-file-if-exists=../../.env seed/simulacao/validar.ts",
    "seed:volume": "node --env-file-if-exists=../../.env seed/volume/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:int": "cd ../.. && vitest run --project db-rls packages/database/"
  },
  "dependencies": {
    "@prisma/client": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@simpleclick/config-ts": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
