# Variáveis do ambiente local — modelo.
#
# Copie para .env.compose e preencha o que estiver vazio:
#     cp infra/compose/.env.compose.example infra/compose/.env.compose
# ou deixe o `bash infra/scripts/setup.sh` fazer isso por você.
#
# Segredo NUNCA vai para o código nem para este modelo (P-002). Os campos de
# senha nascem vazios de propósito: o compose recusa subir sem eles, nomeando
# qual falta. Já os nomes de host e as portas trazem o valor padrão do projeto,
# porque não são segredo e mudá-los é exceção.
#
# .env.compose está no .gitignore. Nunca o adicione ao histórico.

# --- identificação ----------------------------------------------------------
# Prefixo dos contêineres, redes e volumes. Trocar isola um segundo ambiente
# na mesma máquina.
COMPOSE_PROJECT_NAME=simpleclick

# --- nomes de host ----------------------------------------------------------
# Dois nomes sob um domínio comum, igual à topologia de produção
# (simpleclick.app e api.simpleclick.app). O certificado curinga de
# infra/scripts/certs.sh cobre os dois.
HOST_WEB=app.localhost
HOST_API=api.localhost

# --- portas publicadas no computador ----------------------------------------
PORTA_HTTP=80
PORTA_HTTPS=443
# Painel do roteador, para enxergar rota e certificado ao depurar.
PORTA_PAINEL_TRAEFIK=8081

# --- portas internas dos contêineres de aplicação ---------------------------
# O roteador entrega nestas portas. Enquanto api e web forem provisórios, as
# duas valem 80; quando T-019 trouxer o Express e o Next, viram 3001 e 3000.
PORTA_INTERNA_API=80
PORTA_INTERNA_WEB=80

# --- banco de desenvolvimento -----------------------------------------------
# Os dados daqui sobrevivem ao `make down`.
POSTGRES_USUARIO_DEV=simpleclick
POSTGRES_BANCO_DEV=simpleclick_dev
PORTA_POSTGRES_DEV=5432
# obrigatória — gere uma senha local, por exemplo: openssl rand -hex 16
POSTGRES_SENHA_DEV=

# --- banco de teste ---------------------------------------------------------
# Efêmero e descartável: outra porta, outro banco, sem volume (AC-003).
# Apontar a aplicação para cá apaga trabalho — o verificador de ambientes de
# T-003 reprova produção e teste na mesma cadeia de conexão (AC-031).
POSTGRES_USUARIO_TEST=simpleclick_test
POSTGRES_BANCO_TEST=simpleclick_test
PORTA_POSTGRES_TEST=5433
# obrigatória
POSTGRES_SENHA_TEST=

# --- cache ------------------------------------------------------------------
PORTA_REDIS=6379
REDIS_MEMORIA_MAXIMA=256mb
# obrigatória
REDIS_SENHA=

# --- emulador de impressora -------------------------------------------------
# Só sobe no perfil `print`.
PORTA_IMPRESSORA=9100
